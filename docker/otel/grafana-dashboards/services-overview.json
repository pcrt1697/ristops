{
  "title": "Services Overview",
  "uid": "ristops-services-overview",
  "tags": [
    "ristops"
  ],
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_duration_milliseconds_count, service_name)",
          "refId": "service"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total requests",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "none"
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_duration_milliseconds_count{service_name=~\"$service\"}[$__range]))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total errors",
      "description": "Auth (401/403) + other 4xx + 5xx + background/consumer failures. Counted from the actual response status / failure, not from ERROR-level log lines.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "(sum(http_server_duration_milliseconds_count{service_name=~\"$service\", http_status_code=~\"401|403\"}) or vector(0)) + (sum(http_server_duration_milliseconds_count{service_name=~\"$service\", http_status_code=~\"4..\", http_status_code!~\"401|403\"}) or vector(0)) + (sum(http_server_duration_milliseconds_count{service_name=~\"$service\", http_status_code=~\"5..\"}) or vector(0)) + (sum(messaging_consumer_errors_total{service_name=~\"$service\"}) or vector(0))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active requests",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "none"
      },
      "targets": [
        {
          "expr": "sum(http_server_active_requests{service_name=~\"$service\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Request count per service",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_duration_milliseconds_count{service_name=~\"$service\"}[$__range])) by (service_name)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "keepLabels": [
              "service_name"
            ]
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Requests"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Request rate per service",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=~\"$service\"}[5m])) by (service_name)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "keepLabels": [
              "service_name"
            ]
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Requests/s"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Errors per service",
      "description": "Stacked by category: authentication/authorization (401/403), other 4xx, and 5xx + background/consumer failures.",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "cellOptions": {
              "type": "color-background"
            },
            "align": "center"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "service_name"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Other 4xx"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx + background"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "label_replace(sum(http_server_duration_milliseconds_count{service_name=~\"$service\", http_status_code=~\"401|403\"}) by (service_name) or (0 * sum(http_server_duration_milliseconds_count{service_name=~\"$service\"}) by (service_name)), \"category\", \"Auth (401/403)\", \"\", \"\")\nor\nlabel_replace(sum(http_server_duration_milliseconds_count{service_name=~\"$service\", http_status_code=~\"4..\", http_status_code!~\"401|403\"}) by (service_name) or (0 * sum(http_server_duration_milliseconds_count{service_name=~\"$service\"}) by (service_name)), \"category\", \"Other 4xx\", \"\", \"\")\nor\nlabel_replace(sum(http_server_duration_milliseconds_count{service_name=~\"$service\", http_status_code=~\"5..\"}) by (service_name) + sum(messaging_consumer_errors_total{service_name=~\"$service\"}) by (service_name) or sum(http_server_duration_milliseconds_count{service_name=~\"$service\", http_status_code=~\"5..\"}) by (service_name) or sum(messaging_consumer_errors_total{service_name=~\"$service\"}) by (service_name) or (0 * sum(http_server_duration_milliseconds_count{service_name=~\"$service\"}) by (service_name)), \"category\", \"5xx + background\", \"\", \"\")",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "category"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {},
            "indexByName": {
              "service_name": 0,
              "Auth (401/403)": 1,
              "Other 4xx": 2,
              "5xx + background": 3
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Auth (401/403)",
            "Other 4xx",
            "5xx + background"
          ],
          "countRows": false
        }
      }
    }
  ]
}