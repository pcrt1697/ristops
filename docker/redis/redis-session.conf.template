##################################
# Network
##################################

bind 0.0.0.0
port 6379
protected-mode yes

##################################
# Authentication
##################################

user default off
user ristops on >${RISTOPS_REDIS_SESSION_PWD} ~* &* +@all

##################################
# Persistence
##################################

dir /data
appendonly yes
appendfsync everysec

##################################
# Security hardening
##################################

# Disable dangerous commands
rename-command FLUSHDB ""
rename-command FLUSHALL ""
rename-command CONFIG ""
rename-command SHUTDOWN ""
rename-command DEBUG ""

# Memory setup
maxmemory 256mb
maxmemory-policy allkeys-lru

##################################
# Logging
##################################

loglevel notice
