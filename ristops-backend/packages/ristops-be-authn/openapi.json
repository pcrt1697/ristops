  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Error title"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error detail"
          }
        },
        "type": "object",
        "required": [
          "title",
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Standard error response payload. "
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus",
            "description": "Liveness status of the service."
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "description": "Liveness probe payload. "
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok"
        ],
        "title": "HealthStatus"
      },
      "JWK": {
        "properties": {
          "kty": {
            "type": "string",
            "enum": [
              "EC",
              "RSA",
              "oct"
            ],
            "title": "Kty",
            "description": "Key type. Identifies the cryptographic algorithm family. EC for elliptic curve, RSA, or oct for symmetric keys."
          },
          "use": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "sig",
                  "enc"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Use",
            "description": "Intended use of the key. 'sig' for signature verification, 'enc' for encryption."
          },
          "alg": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alg",
            "description": "Algorithm intended for use with this key, e.g. 'ES256', 'RS256'."
          },
          "kid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kid",
            "description": "Key ID. Used to match a specific key in a JWKS when multiple keys are present."
          },
          "crv": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "P-256",
                  "P-384",
                  "P-521"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Crv",
            "description": "EC curve name. Required for EC keys. P-256 corresponds to ES256, P-384 to ES384, P-521 to ES512."
          },
          "x": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "X",
            "description": "Base64url-encoded x coordinate of the EC public key point."
          },
          "y": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Y",
            "description": "Base64url-encoded y coordinate of the EC public key point."
          }
        },
        "type": "object",
        "required": [
          "kty"
        ],
        "title": "JWK"
      },
      "JWKResponse": {
        "properties": {
          "keys": {
            "items": {
              "$ref": "#/components/schemas/JWK"
            },
            "type": "array",
            "title": "Keys",
            "description": "Array of JWK public keys. Clients should use the 'kid' field to select the appropriate key for verification."
          }
        },
        "type": "object",
        "required": [
          "keys"
        ],
        "title": "JWKResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "Email address of the user to log in."
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password",
            "description": "Password of the user to log in.",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "user_id": {
            "type": "string",
