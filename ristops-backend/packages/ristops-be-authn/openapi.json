    "/api/members": {
      "get": {
        "tags": [
          "members"
        ],
        "summary": "Get Members",
        "description": "Search members: the public view of users. Any authenticated user may call this.",
        "operationId": "get_members_api_members_get",
        "parameters": [
          {
            "name": "filter.username",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by username using a like operator.",
              "title": "Filter.Username"
            },
            "description": "Filter by username using a like operator."
          },
          {
            "name": "filter.display_name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by display name using a like operator.",
              "title": "Filter.Display Name"
            },
            "description": "Filter by display name using a like operator."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "0-indexed page number",
              "default": 0,
              "title": "Page"
            },
            "description": "0-indexed page number"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Items per page",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Items per page"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Sortable fields: id, username, display_name, created_at. Prefix a field with '-' for descending.",
              "title": "Sort"
            },
            "description": "Sortable fields: id, username, display_name, created_at. Prefix a field with '-' for descending."
          }
        ],
        "responses": {
          "200": {
