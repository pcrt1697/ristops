            "description": "Username of the user."
          },
          "access_token": {
            "type": "string",
            "title": "Access Token",
            "description": "Access token to use for user authentication."
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token",
            "description": "Token to use for refreshing access token."
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "access_token",
          "refresh_token"
        ],
        "title": "LoginResponse"
      },
      "MemberResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Resource identifier."
          },
          "username": {
            "type": "string",
            "title": "Username",
            "description": "Username of the member."
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name",
            "description": "Display name of the member."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Date and time when the object was created."
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "created_at"
        ],
        "title": "MemberResponse",
        "description": "Public view of a user, readable by any authenticated user."
      },
      "Page_MemberResponse_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MemberResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total_pages": {
            "type": "integer",
            "title": "Total Pages"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "total_pages"
        ],
        "title": "Page[MemberResponse]"
      },
      "RefreshTokenRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token",
            "description": "Token to use for refreshing access token."
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshTokenRequest"
      },
      "UserCreationRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username",
            "description": "Username of the user to register."
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name",
            "description": "Display name of the user to register."
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "Email address of the user to register."
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "format": "password",
            "title": "Password",
            "description": "Password of the user to register.",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "username",
          "email",
          "password"
        ],
        "title": "UserCreationRequest",
        "description": "Request body for creating a new user."
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Resource identifier."
          },
          "username": {
            "type": "string",
            "title": "Username",
            "description": "Username of the user."
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name",
            "description": "Display name of the user."
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "Email address of the user."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Date and time when the object was created."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Date and time when the object was updated."
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "email",
          "created_at",
          "updated_at"
        ],
        "title": "UserResponse"
      },
      "UserUpdateRequest": {
        "properties": {
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username",
            "description": "New username of the user."
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name",
            "description": "New display name of the user."
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "New email address of the user."
          },
          "password": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 8,
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Password",
